# Copy to .env and edit. .env is gitignored -- never commit real values.

# --- How BRE reaches IBM Bob -------------------------------------------------------------------------
# (unset)  auto: Bob Shell if `bob` is on PATH and BOB_API_KEY is set, else a running agent host, else an error
# shell    force Bob Shell            host   force the (experimental, read-only) agent-host WebSocket
# replay   the LABELLED stand-in: no Bob, no credentials. Never chosen automatically. Every screen says SIMULATED.
BRE_BOB_TRANSPORT=replay
# Create an API key with Scope=Inference in the Bob web portal. Needed only for live Bob.
# BOB_API_KEY=

# --- What BRE may change -----------------------------------------------------------------------------
# os.pathsep-separated repositories BRE may write to. Empty = read-only (investigate and diagnose only).
# BRE_REPO_ALLOWLIST=C:\work\payments-api
# Demo mode: BRE builds throwaway fixture repos under BRE_DEMO_DIR and allowlists only that directory.
BRE_DEMO=1
# BRE_DEMO_DIR=
# Hard cap on loop passes per incident (default 3).
# BRE_MAX_ATTEMPTS=3
# Routing threshold. Unset = use the tuned artifact in docs/artifacts, else ASMOS's default 0.35.
# BRE_TAU=0.30

# --- Who may approve ---------------------------------------------------------------------------------
# Approvals record the identity of the key, never a name typed into a form.
BRE_OPERATOR_KEY=change-me
BRE_OPERATOR_NAME=Your Name
# Public demos only: show the key above in the UI so visitors can play the approver. NEVER on a real deployment.
# BRE_DEMO_SHOW_KEY=1

# --- Recording real Bob output (proof of use + a genuine replay source) -------------------------------
# BRE_BOB_RECORD_DIR=recordings
